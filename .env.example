# ---------------------------------------------------------------------------
# Supabase — auth, Postgres (RLS), Storage
# https://app.supabase.com/project/_/settings/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role — jamais exposée au client, réservée aux tâches serveur
# (webhooks, jobs de publication programmée, synchronisation des statistiques).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic (Claude) — génération de texte : positionnement, idées, scripts,
# carrousels, légendes, analyses, conseiller. Jamais de génération vidéo.
# https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Stripe — abonnements, essai, portail client, webhooks
# https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_ESSENTIEL_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ---------------------------------------------------------------------------
# Resend — emails transactionnels (confirmation, relance, alertes d'échec)
# https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Growthis <bonjour@growthis.io>"

# ---------------------------------------------------------------------------
# File de tâches (publication programmée, synchronisation des statistiques)
# Voir README pour le choix entre Trigger.dev et Inngest.
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=
# ou
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Réseaux sociaux — Publier (Phase 4)
# Les jetons obtenus via ces apps sont chiffrés avant stockage en base
# (voir ENCRYPTION_KEY ci-dessous). Aucune clé secrète n'est exposée au client.
# ---------------------------------------------------------------------------

# Meta (Instagram Graph API + Facebook Pages)
# https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# TikTok Content Posting API
# https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn (Marketing Developer Platform requis pour les pages entreprise)
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google / YouTube Data API v3
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des jetons sociaux en base (32 octets, encodée en base64)
# Génération : openssl rand -base64 32
ENCRYPTION_KEY=
